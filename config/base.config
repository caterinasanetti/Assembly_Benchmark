manifest {
    name        = 'assembly_benchmark'
    version     = '0.1.0'
    description = 'Benchmark metagenomic assemblies with SPAdes, MEGAHIT, Shovill, and QUAST'
}

params {
    input_dir = '/lustre1/scratch/389/vsc38925/wgs_tests/all_fastqs'
    read_pattern = '*_{1,2}.fq.gz'
    reads = null

    output_dir = './results'
    reference_genome = null
    genome_size = null
    depths = [50, 100, 150]
    depths_shovill = [50, 100, 150]   // 0 = raw, no subsampling cap

    seqkit_container = 'quay.io/biocontainers/seqkit:2.8.2--h9ee0642_0'
    spades_container = 'quay.io/biocontainers/spades:3.15.5--h95f258a_1'
    bbnorm_container = 'quay.io/biocontainers/bbmap:39.06--h92535d8_0'
    megahit_container = 'quay.io/biocontainers/megahit:1.2.9--h5b5514e_3'
    shovill_container = 'quay.io/biocontainers/shovill:1.1.0--0'
    quast_container = 'quay.io/biocontainers/quast:5.2.0--py39pl5321h4e691d4_3'

    apptainer_cache_dir = null
}

process {
    cpus = { 1 * task.attempt }
    memory = { 512.MB * (2 ** (task.attempt - 1)) }
    time = '3d'
    queue = 'batch_icelake'
    errorStrategy = { task.exitStatus in ((130..145) + [104] + (175..177)) ? 'retry' : 'finish' }
    maxRetries = 3
    maxErrors = '-1'

    withName: 'SEQKIT_STATS' {
        cpus = 2
        memory = 4.GB
        container = params.seqkit_container
    }
    withName: 'SEQKIT_SUBSAMPLE' {
        cpus = 2
        memory = 4.GB
        container = params.seqkit_container
    }
    withName: 'SPADES_ASSEMBLE_S|SPADES_ASSEMBLE_B' {
        cpus = 8
        memory = 16.GB
        container = params.spades_container
    }
    withName: 'BBNORM' {
        cpus = 4
        memory = 8.GB
        container = params.bbnorm_container
    }
    withName: 'MEGAHIT_ASSEMBLE' {
        cpus = 8
        memory = 16.GB
        container = params.megahit_container
    }
    withName: 'SHOVILL_ASSEMBLE' {
        cpus = 8
        memory = 16.GB
        container = params.shovill_container
        publishDir = [ path: { "${params.output_dir}/assembly/shovill" }, mode: 'copy' ]
    }
    withName: 'QUAST_COMPARE' {
        cpus = 4
        memory = 8.GB
        container = params.quast_container
    }
}

profiles {
    wICE {
        params {
            apptainer_cache_dir = params.apptainer_cache_dir ?: '/scratch/leuven/389/vsc38925/containers'
        }
        process {
            executor = 'slurm'
            clusterOptions = '-A lp_gut_metag -M wICE --export=all'
        }
        executor {
            queueSize = 400
            submitRateLimit = '1/sec'
        }
        apptainer {
            enabled = true
            autoMounts = true
            runOptions = '--bind /lustre1:/lustre1'
            cacheDir = params.apptainer_cache_dir
        }
    }

    local {
        params {
            apptainer_cache_dir = params.apptainer_cache_dir ?: (System.getenv('XDG_CACHE_HOME') ?: "${System.getProperty('user.home')}/.apptainer/cache")
        }
        process {
            executor = 'local'
        }
        executor {
            queueSize = 5
            submitRateLimit = '1/sec'
        }
        apptainer {
            enabled = true
            autoMounts = true
            cacheDir = params.apptainer_cache_dir
        }
    }
}

report {
    enabled = true
    overwrite = true
    file = "${params.output_dir}/execution/report.html"
}